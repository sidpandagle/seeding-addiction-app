{
  "expo": {
    "name": "Seeding",
    "slug": "seeding",
    "scheme": "seeding",
    "version": "2.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/fonts/**",
      "assets/images/**",
      "assets/lottie/**",
      "assets/*.png"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seeding.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.seeding.app",
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5ef964ec-8a28-4f7e-b62c-7b15f3ca3d44"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f9fafb",
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#395141"
          },
          "imageWidth": 350
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing"
    ]
  }
}
